      rdfs:isDefinedBy <http://purl.obolibrary.org/obo/bfo.owl> ;
      rdfs:label "site"@en ;
      rdfs:subClassOf obo:BFO_0000141 ;
      obo:BFO_0000179 "site" ;
      obo:BFO_0000180 "Site" ;
      obo:IAO_0000112 "an air traffic control region defined in the airspace above an airport"@en , "the interior of the trunk of your car"@en , "the interior of your refrigerator"@en , "the interior of a kangaroo pouch"@en , "the hold of a ship"@en , "Manhattan Canyon)"@en , "the Grand Canyon"@en , "a hole in the interior of a portion of cheese"@en , "a rabbit hole"@en , "the lumen of your gut"@en , "the cockpit of an aircraft"@en , "your left nostril (a fiat part – the opening – of your left nasal cavity)"@en , "the interior of your office"@en , "the interior of your bedroom"@en , "the Piazza San Marco"@en ;
      obo:IAO_0000600 "b is a site means: b is a three-dimensional immaterial entity that is (partially or wholly) bounded by a material entity or it is a three-dimensional immaterial part thereof. (axiom label in BFO2 Reference: [034-002])"@en ;
      obo:IAO_0000602 "(forall (x) (if (Site x) (ImmaterialEntity x))) // axiom label in BFO2 CLIF: [034-002] " .

