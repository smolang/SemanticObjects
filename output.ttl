<http://purl.obolibrary.org/obo/bfo.owl#UFRGS:GeoCoreOntology_geological_object>
      a       owl:Class ;
      rdfs:label "geological object"@en ;
      rdfs:subClassOf obo:BFO_0000030 ;
      obo:IAO_0000115 "A Geological Object is a rigid entity that provides its own identity and holds a unity criteria. A Geological Object is constituted by Earth Material and is generated by some Geological Process." ;
      owl:equivalentClass
              [ a       owl:Class ;
                owl:intersectionOf (obo:BFO_0000030 [ a       owl:Restriction ;
                            owl:onProperty <http://purl.obolibrary.org/obo/bfo.owl#UFRGS:GeoCoreOntology_has_age> ;
                            owl:someValuesFrom <http://purl.obolibrary.org/obo/bfo.owl#UFRGS:GeoCoreOntology_geological_age>
                          ] [ a       owl:Restriction ;
                            owl:allValuesFrom <http://purl.obolibrary.org/obo/bfo.owl#UFRGS:GeoCoreOntology_earth_material> ;
                            owl:onProperty <http://purl.obolibrary.org/obo/bfo.owl#UFRGS:GeoCoreOntology_constituted_by>
                          ] [ a       owl:Restriction ;
                            owl:allValuesFrom <http://purl.obolibrary.org/obo/bfo.owl#UFRGS:GeoCoreOntology_geological_process> ;
                            owl:onProperty <http://purl.obolibrary.org/obo/bfo.owl#UFRGS:GeoCoreOntology_generated_by>
                          ])
              ] .

