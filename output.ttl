domain:chalk_unit_fracturing_trigger
      a       owl:Class ;
      rdfs:comment "datavalue unit: MPa (megapascals)"@en , "Fracturing value is from the work of Ojala 2011"@en , "depending on several factors, including the grain size, porosity, and water content of the rock. In addition, the presence of natural fractures, faults, or other geological features can significantly impact the tensile strength of the rock and make it more susceptible to fracturing." ;
      rdfs:label "chalk fracturing trigger" ;
      rdfs:subClassOf domain:fracturing_trigger .

