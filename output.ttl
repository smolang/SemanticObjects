              obo:IAO_0000602 ;
      owl:annotatedSource obo:BFO_0000019 ;
      owl:annotatedTarget "(forall (x) (if (exists (t) (and (existsAt x t) (Quality x))) (forall (t_1) (if (existsAt x t_1) (Quality x))))) // axiom label in BFO2 CLIF: [105-001] " .

