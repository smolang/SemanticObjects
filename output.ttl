[]    a       owl:Axiom ;
      obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/085-002> ;
      owl:annotatedProperty
              obo:IAO_0000602 ;
      owl:annotatedSource obo:BFO_0000035 ;
