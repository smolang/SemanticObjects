// reada src/test/resources/csparql/12_different_ranges.smol

class Observation(Int x, Int ts) end

class Controller(List<C> streamers, Monitor<Int> m)
    
    Unit register()
        Monitor<Int> m = monitor("
            SELECT ?x
            FROM NAMED WINDOW <win1> ON %1 [RANGE PT4.001s STEP PT2s]
            FROM NAMED WINDOW <win2> ON %2 [RANGE PT3.001s STEP PT1s]
            FROM NAMED WINDOW <win3> ON %3 [RANGE PT5.001s STEP PT4s]
            WHERE {
                { WINDOW <win1> { ?s prog:C_x ?x. } }
                UNION
                { WINDOW <win2> { ?s prog:C_x ?x. } }
                UNION
                { WINDOW <win3> { ?s prog:C_x ?x. } }
            }
        ", 
            this.streamers.content,
            this.streamers.next.content,
            this.streamers.next.next.content
        );
        this.m = m;
    end

    Unit doStream()
        List<C> objs = this.streamers;
        while objs != null do
            C o = objs.content;
            o.doStream();
            objs = objs.next;
        end
    end

    String windowToString()
        String s = "";
        List<Int> l = window(this.m);
        while l != null do
            s = s ++ intToString(l.content) ++ " ";
            l = l.next;
        end
        return s;
    end

end

streamer class C(Int x)

    Unit doStream() emits(this.x)
        this.x = this.x + 1;
    end

end

main
    // configure simulation
    clock Int i = 100;
    Int endAt = 200;

    // initialize stream
    C o1 = new C(0);
    C o2 = new C(10);
    C o3 = new C(20);
    List<C> l3 = new List<C>(o3, null);
    List<C> l2 = new List<C>(o2, l3);
    List<C> streamers = new List<C>(o1, l2);

    Controller ctrl = new Controller(streamers, null);

    // initialize monitor
    ctrl.register();

    // run simulation
    while i < endAt do

        // put triples in the stream
        ctrl.doStream(i);

        // read window contents
        String res = ctrl.windowToString();
        print(">>" ++ intToString(i) ++ ": " ++ res);

        // advance clock (timestamp)
        i = i + 1;
    end
end

// Output:
// >>100: 
// >>101: 
// >>102: 
// >>103: 11 21 1 12 22 2                    : 1-2, 11-12, 21-22
// >>104: 11 21 1 12 22 2 
// >>105: 22 4 21 24 12 23 1 11 14 13 2 3    : 2-5, 12-15, 22-25
// >>106: 22 4 21 24 12 23 1 11 14 13 2 3 
// >>107: 26 4 25 6 24 23 14 13 16 3 5 15    : 3-6, 13-16, 23-26
// >>108: 26 4 25 6 24 23 14 13 16 3 5 15 
// >>109: 18 26 17 25 6 7 28 27 8 16 5 15    : 5-8, 15-18, 25-28
// >>110: 18 26 17 25 6 7 28 27 8 16 5 15 
// >>111: 18 17 10 20 7 28 19 27 30 8 29 9   : 7-10, 17-20, 27-30
// >>112: 18 17 10 20 7 28 19 27 30 8 29 9 
// >>113: 10 11 20 19 22 12 30 21 29 32 31 9 : 9-12, 19-22, 29-32


// Notes:
// - First range and step applies: [RANGE 4s STEP 2s]
