<?xml version="1.0" encoding="utf-8" ?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:prog="https://github.com/Edkamb/SemanticObjects/Program#"
         xmlns:ns0="https://example.com/ontology#">

  <owl:Class rdf:about="https://example.com/ontology#Class">
  </owl:Class>

  <!-- ex:StreamerClass rdfs:subClassOf ex:Class . -->
  <owl:Class rdf:about="https://example.com/ontology#StreamerClass">
    <rdfs:subClassOf rdf:resource="https://example.com/ontology#Class"/>
  </owl:Class>

  <owl:Class rdf:about="https://github.com/Edkamb/SemanticObjects/Program#Observation">
    <rdfs:subClassOf rdf:resource="https://github.com/Edkamb/SemanticObjects/Program#SensorData"/>
  </owl:Class>

</rdf:RDF>
