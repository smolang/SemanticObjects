streamer class C(Int x, Monitor<Int> m)

    Unit register()
        Monitor<Int> m = monitor("
            SELECT (SUM(?x) as ?sumX)
            FROM STREAM %1 [RANGE 5s STEP 2s]
            WHERE { ?s prog:C_x ?x }
        ", this);
        this.m = m;
    end

    Unit doStream() emits(this.x)
        this.x = this.x + 1;
    end

    String windowToString()
        String s = "";
        List<Int> l = window(this.m);
        while l != null do
            s = s ++ intToString(l.content) ++ " ";
            if l.content / 20 * 20 == l.content then
                s = s ++ "mult20 ";
            end
            l = l.next;
        end
        return s;
    end
end

main
    C o = new C(0, null);
    o.register();

    clock Int i = 100;
    Int endAt = 200;

    while i < endAt do
        o.doStream();
        String res = o.windowToString();
        print(">>" ++ intToString(i) ++ ": " ++ res);
        i = i + 1;
    end
end

// Output:
// >>100: 
// >>101: 
// >>102: 3 
// >>103: 3 
// >>104: 10 
// >>105: 10 
// >>106: 20 mult20 
// >>107: 20 mult20 
// >>108: 30 
// >>109: 30 
// >>110: 40 mult20 
// >>111: 40 mult20 
// >>112: 50 

// Notes:
// - Shows how to use the window results (e.g., check if the sum is multiple of 20)
